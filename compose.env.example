# Copiar como compose.env y reemplazar los placeholders. Nunca versionar compose.env.
VCS_REF=replace-with-full-commit-sha
IMAGE_TAG=local

# El directorio debe existir y contar con permisos para UID/GID 10001.
DEFORESTATION_PRIVATE_ROOT=./tmp/compose-private

# Archivos existentes; Compose no crea estos paths automáticamente.
DEFORESTATION_GEE_CREDENTIALS=./credentials.json
DEFORESTATION_RF_MODEL_ARTIFACT=./outputs/models/rf_forest_multiyear_2020_2024_v1/random_forest_forest_multiyear_2020_2024.joblib

# Límites iniciales para el smoke local; deben ajustarse con mediciones.
DEFORESTATION_API_CPUS=0.50
DEFORESTATION_API_MEMORY=512m
DEFORESTATION_API_MEMORY_RESERVATION=256m
DEFORESTATION_API_TMPFS_SIZE=64m
DEFORESTATION_WORKER_CPUS=4.0
DEFORESTATION_WORKER_MEMORY=8g
DEFORESTATION_WORKER_MEMORY_RESERVATION=2g
DEFORESTATION_WORKER_TMPFS_SIZE=512m
