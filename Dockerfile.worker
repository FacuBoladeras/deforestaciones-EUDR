# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.10.12@sha256:72ab0aeb448090480ccabb99fb5f52b0dc3c71923bffb5e2e26517a1c27b7fec

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS builder

COPY --from=uv /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY packages/domain/pyproject.toml packages/domain/pyproject.toml
COPY packages/jobs/pyproject.toml packages/jobs/pyproject.toml
COPY packages/reporting/pyproject.toml packages/reporting/pyproject.toml
COPY services/api/pyproject.toml services/api/pyproject.toml
COPY services/worker/pyproject.toml services/worker/pyproject.toml

COPY src src
COPY packages/domain/src packages/domain/src
COPY packages/jobs/src packages/jobs/src
COPY packages/reporting/src packages/reporting/src
COPY services/worker/src services/worker/src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable --package deforestation-worker

FROM ${PYTHON_IMAGE} AS runtime

ARG VCS_REF

LABEL org.opencontainers.image.title="Deforestation Evidence Worker" \
      org.opencontainers.image.revision="${VCS_REF}"

ENV PATH=/app/.venv/bin:${PATH} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    XDG_CACHE_HOME=/tmp/.cache \
    DEFORESTATION_RUNTIME_ROOT=/opt/deforestation/runtime \
    DEFORESTATION_API_PRIVATE_ROOT=/var/lib/deforestation/private \
    DEFORESTATION_ANALYSIS_OUTPUT_ROOT=/var/lib/deforestation/runs \
    DEFORESTATION_GEE_CREDENTIALS=/run/secrets/gee-credentials.json \
    DEFORESTATION_RF_MODEL_ARTIFACT=/opt/deforestation/models/random_forest_forest_multiyear_2020_2024.joblib \
    DEFORESTATION_CODE_REVISION=${VCS_REF}

RUN test "${#VCS_REF}" -eq 40 \
    && case "${VCS_REF}" in *[!0-9a-f]*) exit 1 ;; *) true ;; esac \
    && groupadd --gid 10001 worker \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin worker \
    && install -d -o 10001 -g 10001 \
        /app \
        /var/lib/deforestation/private \
        /var/lib/deforestation/runs \
    && install -d /opt/deforestation/models /run/secrets

WORKDIR /app

COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv
COPY configs /opt/deforestation/runtime/configs
COPY data/catalog.yml data/licenses.yml /opt/deforestation/runtime/data/
COPY data/schemas /opt/deforestation/runtime/data/schemas
COPY data/models/rf_forest_multiyear_2020_2024_v1.json \
    /opt/deforestation/runtime/data/models/rf_forest_multiyear_2020_2024_v1.json
COPY scripts/run_complete_analysis.py /opt/deforestation/runtime/scripts/run_complete_analysis.py

USER 10001:10001

STOPSIGNAL SIGTERM

HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD ["deforestation-worker", "--healthcheck"]

CMD ["deforestation-worker"]
