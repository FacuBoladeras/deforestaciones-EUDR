# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.10.12@sha256:72ab0aeb448090480ccabb99fb5f52b0dc3c71923bffb5e2e26517a1c27b7fec

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS builder

COPY --from=uv /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# uv needs every workspace manifest to validate uv.lock, but only the API and
# its two internal dependencies are copied as source and installed.
COPY pyproject.toml uv.lock README.md ./
COPY packages/domain/pyproject.toml packages/domain/pyproject.toml
COPY packages/jobs/pyproject.toml packages/jobs/pyproject.toml
COPY packages/reporting/pyproject.toml packages/reporting/pyproject.toml
COPY services/api/pyproject.toml services/api/pyproject.toml
COPY services/worker/pyproject.toml services/worker/pyproject.toml

COPY packages/domain/src packages/domain/src
COPY packages/jobs/src packages/jobs/src
COPY services/api/src services/api/src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable --package deforestation-api

FROM ${PYTHON_IMAGE} AS runtime

ARG VCS_REF

LABEL org.opencontainers.image.title="Deforestation Evidence API" \
      org.opencontainers.image.revision="${VCS_REF}"

ENV PATH=/app/.venv/bin:${PATH} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEFORESTATION_RUNTIME_ROOT=/opt/deforestation/runtime \
    DEFORESTATION_API_PRIVATE_ROOT=/var/lib/deforestation/private \
    DEFORESTATION_CODE_REVISION=${VCS_REF}

RUN test "${#VCS_REF}" -eq 40 \
    && case "${VCS_REF}" in *[!0-9a-f]*) exit 1 ;; *) true ;; esac \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin app \
    && install -d -o 10001 -g 10001 /app /var/lib/deforestation/private

WORKDIR /app

COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv
COPY --chown=10001:10001 \
    data/boundaries/argentina_operational.geojson \
    data/boundaries/argentina_operational.metadata.json \
    /opt/deforestation/runtime/data/boundaries/

USER 10001:10001

EXPOSE 8000
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).read()"]

CMD ["uvicorn", "deforestation_api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
