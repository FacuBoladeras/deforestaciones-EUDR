{
  "$defs": {
    "CoverageState": {
      "enum": [
        "complete_observed_coverage",
        "partial_observed_coverage",
        "no_observed_coverage"
      ],
      "title": "CoverageState",
      "type": "string"
    },
    "HlsYearCoverage": {
      "additionalProperties": false,
      "properties": {
        "coverage_state": {
          "$ref": "#/$defs/CoverageState"
        },
        "input_scene_count": {
          "minimum": 1,
          "title": "Input Scene Count",
          "type": "integer"
        },
        "l30_count": {
          "$ref": "#/$defs/ObservationCountStatistics"
        },
        "l30_scene_count": {
          "minimum": 0,
          "title": "L30 Scene Count",
          "type": "integer"
        },
        "observed_pixel_count_l30": {
          "minimum": 0,
          "title": "Observed Pixel Count L30",
          "type": "integer"
        },
        "observed_pixel_count_s30": {
          "minimum": 0,
          "title": "Observed Pixel Count S30",
          "type": "integer"
        },
        "observed_pixel_count_total": {
          "minimum": 0,
          "title": "Observed Pixel Count Total",
          "type": "integer"
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "roi_pixel_count": {
          "exclusiveMinimum": 0,
          "title": "Roi Pixel Count",
          "type": "integer"
        },
        "s30_count": {
          "$ref": "#/$defs/ObservationCountStatistics"
        },
        "s30_scene_count": {
          "minimum": 0,
          "title": "S30 Scene Count",
          "type": "integer"
        },
        "total_count": {
          "$ref": "#/$defs/ObservationCountStatistics"
        },
        "valid_pixel_fraction_l30": {
          "maximum": 1,
          "minimum": 0,
          "title": "Valid Pixel Fraction L30",
          "type": "number"
        },
        "valid_pixel_fraction_s30": {
          "maximum": 1,
          "minimum": 0,
          "title": "Valid Pixel Fraction S30",
          "type": "number"
        },
        "valid_pixel_fraction_total": {
          "maximum": 1,
          "minimum": 0,
          "title": "Valid Pixel Fraction Total",
          "type": "number"
        },
        "year": {
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "year",
        "input_scene_count",
        "l30_scene_count",
        "s30_scene_count",
        "roi_pixel_count",
        "observed_pixel_count_total",
        "observed_pixel_count_l30",
        "observed_pixel_count_s30",
        "valid_pixel_fraction_total",
        "valid_pixel_fraction_l30",
        "valid_pixel_fraction_s30",
        "total_count",
        "l30_count",
        "s30_count",
        "coverage_state",
        "quality_flags"
      ],
      "title": "HlsYearCoverage",
      "type": "object"
    },
    "ObservationCountStatistics": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "minimum": 0,
          "title": "Maximum",
          "type": "number"
        },
        "median": {
          "minimum": 0,
          "title": "Median",
          "type": "number"
        },
        "minimum": {
          "minimum": 0,
          "title": "Minimum",
          "type": "number"
        },
        "p05": {
          "minimum": 0,
          "title": "P05",
          "type": "number"
        },
        "p95": {
          "minimum": 0,
          "title": "P95",
          "type": "number"
        }
      },
      "required": [
        "minimum",
        "p05",
        "median",
        "p95",
        "maximum"
      ],
      "title": "ObservationCountStatistics",
      "type": "object"
    }
  },
  "$id": "urn:deforestation-pipeline:hls-series-coverage:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "grid_sha256": {
      "title": "Grid Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "years": {
      "items": {
        "$ref": "#/$defs/HlsYearCoverage"
      },
      "title": "Years",
      "type": "array"
    }
  },
  "required": [
    "grid_sha256",
    "years"
  ],
  "title": "HlsSeriesCoverageDocument",
  "type": "object",
  "x-schema-version": "1.0.0"
}
