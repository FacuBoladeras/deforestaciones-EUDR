{
  "$defs": {
    "SeasonCode": {
      "enum": [
        "DJF",
        "MAM",
        "JJA",
        "SON"
      ],
      "title": "SeasonCode",
      "type": "string"
    },
    "SeasonDefinition": {
      "additionalProperties": false,
      "description": "Regla calendaria versionada para una estación meteorológica.",
      "properties": {
        "code": {
          "$ref": "#/$defs/SeasonCode"
        },
        "end_day": {
          "maximum": 31,
          "minimum": 1,
          "title": "End Day",
          "type": "integer"
        },
        "end_month": {
          "maximum": 12,
          "minimum": 1,
          "title": "End Month",
          "type": "integer"
        },
        "end_year_offset": {
          "const": 0,
          "title": "End Year Offset",
          "type": "integer"
        },
        "label_es": {
          "enum": [
            "verano",
            "otoño",
            "invierno",
            "primavera"
          ],
          "title": "Label Es",
          "type": "string"
        },
        "start_day": {
          "maximum": 31,
          "minimum": 1,
          "title": "Start Day",
          "type": "integer"
        },
        "start_month": {
          "maximum": 12,
          "minimum": 1,
          "title": "Start Month",
          "type": "integer"
        },
        "start_year_offset": {
          "enum": [
            -1,
            0
          ],
          "title": "Start Year Offset",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "label_es",
        "start_month",
        "start_day",
        "start_year_offset",
        "end_month",
        "end_day",
        "end_year_offset"
      ],
      "title": "SeasonDefinition",
      "type": "object"
    },
    "TemporalWindow": {
      "additionalProperties": false,
      "description": "Período cerrado, ordenable y sin ambigüedad de límites.",
      "properties": {
        "complete_period": {
          "const": true,
          "default": true,
          "title": "Complete Period",
          "type": "boolean"
        },
        "crosses_calendar_year": {
          "title": "Crosses Calendar Year",
          "type": "boolean"
        },
        "end_date_exclusive": {
          "format": "date",
          "title": "End Date Exclusive",
          "type": "string"
        },
        "expected_days": {
          "exclusiveMinimum": 0,
          "title": "Expected Days",
          "type": "integer"
        },
        "period_id": {
          "pattern": "^\\d{4}-(DJF|MAM|JJA|SON)$",
          "title": "Period Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "season": {
          "$ref": "#/$defs/SeasonCode"
        },
        "season_year": {
          "minimum": 2015,
          "title": "Season Year",
          "type": "integer"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        }
      },
      "required": [
        "period_id",
        "season_year",
        "season",
        "start_date",
        "end_date_exclusive",
        "expected_days",
        "crosses_calendar_year"
      ],
      "title": "TemporalWindow",
      "type": "object"
    }
  },
  "$id": "urn:deforestation-pipeline:temporal-window-plan:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Plan completo que separa años solicitados de fechas auxiliares.",
  "properties": {
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "requested_end_year": {
      "minimum": 2015,
      "title": "Requested End Year",
      "type": "integer"
    },
    "requested_start_year": {
      "minimum": 2015,
      "title": "Requested Start Year",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "season_definitions": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/SeasonDefinition"
        },
        {
          "$ref": "#/$defs/SeasonDefinition"
        },
        {
          "$ref": "#/$defs/SeasonDefinition"
        },
        {
          "$ref": "#/$defs/SeasonDefinition"
        }
      ],
      "title": "Season Definitions",
      "type": "array"
    },
    "support_end_date_exclusive": {
      "format": "date",
      "title": "Support End Date Exclusive",
      "type": "string"
    },
    "support_start_date": {
      "format": "date",
      "title": "Support Start Date",
      "type": "string"
    },
    "temporal_scheme": {
      "const": "meteorological_south_v1",
      "title": "Temporal Scheme",
      "type": "string"
    },
    "windows": {
      "items": {
        "$ref": "#/$defs/TemporalWindow"
      },
      "minItems": 4,
      "title": "Windows",
      "type": "array"
    }
  },
  "required": [
    "generated_at",
    "temporal_scheme",
    "season_definitions",
    "requested_start_year",
    "requested_end_year",
    "support_start_date",
    "support_end_date_exclusive",
    "windows",
    "plan_sha256"
  ],
  "title": "TemporalWindowPlan",
  "type": "object",
  "x-schema-version": "1.0.0"
}
