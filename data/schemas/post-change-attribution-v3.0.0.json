{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deforestation-pipeline:post-change-attribution:3.0.0",
  "title": "Post-change attribution v3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "analysis_id", "establishment_id", "created_at", "status",
    "automatic_final_assessment_generated", "conversion_confirmed_count",
    "conversion_likely_count", "likely_conversion_area_ha",
    "counts_by_post_change_use", "events"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "analysis_id": {"type": "string", "format": "uuid"},
    "establishment_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"const": "review_required"},
    "automatic_final_assessment_generated": {"const": false},
    "conversion_confirmed_count": {"const": 0},
    "conversion_likely_count": {"type": "integer", "minimum": 0},
    "likely_conversion_area_ha": {"type": "number", "minimum": 0},
    "counts_by_post_change_use": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "schema_version", "event_id", "post_change_use", "automatic_status",
          "conversion_confirmed", "human_review_required", "gates", "reason_codes",
          "reasons_for", "reasons_against", "persistent_agricultural_area_ha",
          "likely_conversion_area_ha", "trajectory", "context", "quality_flags"
        ],
        "properties": {
          "schema_version": {"const": "3.0.0"},
          "event_id": {"type": "string", "minLength": 1},
          "post_change_use": {"enum": ["agriculture_likely", "forest_recovery", "managed_harvest", "temporary_disturbance", "unknown"]},
          "automatic_status": {"enum": ["review_required", "conversion_likely"]},
          "conversion_confirmed": {"const": false},
          "human_review_required": {"const": true},
          "gates": {"type": "object"},
          "reason_codes": {"type": "array", "items": {"type": "string"}},
          "reasons_for": {"type": "array", "items": {"type": "string"}},
          "reasons_against": {"type": "array", "items": {"type": "string"}},
          "persistent_agricultural_area_ha": {"type": "number", "minimum": 0},
          "likely_conversion_area_ha": {"type": "number", "minimum": 0},
          "agricultural_spatial_support": {"type": ["object", "null"]},
          "trajectory": {"type": "object"},
          "context": {"type": "object"},
          "quality_flags": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
