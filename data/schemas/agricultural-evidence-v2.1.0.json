{
  "$defs": {
    "AgriculturalEvidenceGeometry": {
      "additionalProperties": false,
      "description": "Huella atribuida, conservada separadamente de la geometría del evento.",
      "properties": {
        "coordinates": {
          "items": {},
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "crs": {
          "pattern": "^EPSG:\\d+$",
          "title": "Crs",
          "type": "string"
        },
        "type": {
          "enum": [
            "Polygon",
            "MultiPolygon"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates",
        "crs"
      ],
      "title": "AgriculturalEvidenceGeometry",
      "type": "object"
    },
    "AgriculturalEvidenceObservationV2": {
      "additionalProperties": false,
      "description": "Evidencia de al menos una ocurrencia agrícola mensual post-evento.",
      "properties": {
        "artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/AgriculturalEvidenceGeometry"
        },
        "land_use": {
          "enum": [
            "crop",
            "pasture",
            "livestock_infrastructure",
            "other",
            "unknown"
          ],
          "title": "Land Use",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/AgriculturalEvidenceQuality"
        },
        "source": {
          "$ref": "#/$defs/AgriculturalEvidenceSource"
        },
        "source_descriptor_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Descriptor Sha256",
          "type": "string"
        },
        "spatial_support": {
          "$ref": "#/$defs/AgriculturalSpatialSupport"
        },
        "temporal_support": {
          "$ref": "#/$defs/AgriculturalOccurrenceTemporalSupport"
        }
      },
      "required": [
        "evidence_id",
        "event_id",
        "land_use",
        "source",
        "source_descriptor_sha256",
        "geometry",
        "spatial_support",
        "temporal_support",
        "quality",
        "artifact_sha256"
      ],
      "title": "AgriculturalEvidenceObservationV2",
      "type": "object"
    },
    "AgriculturalEvidenceQuality": {
      "additionalProperties": false,
      "description": "Calidad declarada sin convertir un score en probabilidad calibrada.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "confidence_semantics": {
          "minLength": 1,
          "title": "Confidence Semantics",
          "type": "string"
        },
        "discarded_observation_reasons": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Discarded Observation Reasons",
          "type": "array"
        },
        "nodata_area_ha": {
          "minimum": 0,
          "title": "Nodata Area Ha",
          "type": "number"
        },
        "quality_flags": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "uncertainty_notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Uncertainty Notes",
          "type": "array"
        }
      },
      "required": [
        "confidence_semantics",
        "quality_flags",
        "discarded_observation_reasons",
        "nodata_area_ha",
        "uncertainty_notes"
      ],
      "title": "AgriculturalEvidenceQuality",
      "type": "object"
    },
    "AgriculturalEvidenceSource": {
      "additionalProperties": false,
      "description": "Identidad y licencia del dataset efectivamente observado.",
      "properties": {
        "access_date": {
          "format": "date",
          "title": "Access Date",
          "type": "string"
        },
        "asset": {
          "minLength": 1,
          "title": "Asset",
          "type": "string"
        },
        "attribution": {
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "collection": {
          "minLength": 1,
          "title": "Collection",
          "type": "string"
        },
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "restrictions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "provider",
        "collection",
        "version",
        "asset",
        "license",
        "access_date",
        "attribution",
        "restrictions"
      ],
      "title": "AgriculturalEvidenceSource",
      "type": "object"
    },
    "AgriculturalOccurrenceTemporalSupport": {
      "additionalProperties": false,
      "description": "Soporte temporal de ocurrencia, separado de suficiencia de seguimiento.",
      "properties": {
        "effective_observation_date": {
          "format": "date",
          "title": "Effective Observation Date",
          "type": "string"
        },
        "estimated_onset_window_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimated Onset Window End"
        },
        "evidence_basis": {
          "enum": [
            "any_qualifying_post_event_period",
            "candidate_coverage_at_least_five_percent_post_cutoff"
          ],
          "title": "Evidence Basis",
          "type": "string"
        },
        "evidence_rule": {
          "minLength": 1,
          "title": "Evidence Rule",
          "type": "string"
        },
        "evidence_satisfied": {
          "const": true,
          "title": "Evidence Satisfied",
          "type": "boolean"
        },
        "long_gap_interpolation_used": {
          "const": false,
          "title": "Long Gap Interpolation Used",
          "type": "boolean"
        },
        "post_change_window_end": {
          "format": "date",
          "title": "Post Change Window End",
          "type": "string"
        },
        "post_change_window_start": {
          "format": "date",
          "title": "Post Change Window Start",
          "type": "string"
        },
        "qualifying_period_count": {
          "minimum": 1,
          "title": "Qualifying Period Count",
          "type": "integer"
        },
        "signal_strength": {
          "enum": [
            "weak",
            "moderate",
            "strong"
          ],
          "title": "Signal Strength",
          "type": "string"
        },
        "valid_period_count": {
          "minimum": 1,
          "title": "Valid Period Count",
          "type": "integer"
        }
      },
      "required": [
        "estimated_onset_window_end",
        "post_change_window_start",
        "post_change_window_end",
        "effective_observation_date",
        "valid_period_count",
        "qualifying_period_count",
        "evidence_basis",
        "evidence_satisfied",
        "signal_strength",
        "long_gap_interpolation_used",
        "evidence_rule"
      ],
      "title": "AgriculturalOccurrenceTemporalSupport",
      "type": "object"
    },
    "AgriculturalSpatialSupport": {
      "additionalProperties": false,
      "description": "Cobertura espacial efectiva medida dentro del evento.",
      "properties": {
        "attributed_area_ha": {
          "minimum": 0,
          "title": "Attributed Area Ha",
          "type": "number"
        },
        "attributed_event_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Attributed Event Fraction",
          "type": "number"
        },
        "event_area_ha": {
          "exclusiveMinimum": 0,
          "title": "Event Area Ha",
          "type": "number"
        },
        "event_coverage_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Event Coverage Fraction",
          "type": "number"
        },
        "resampling_method": {
          "default": "none_native_grid",
          "minLength": 1,
          "title": "Resampling Method",
          "type": "string"
        },
        "source_resolution_m": {
          "exclusiveMinimum": 0,
          "title": "Source Resolution M",
          "type": "number"
        },
        "valid_area_ha": {
          "minimum": 0,
          "title": "Valid Area Ha",
          "type": "number"
        }
      },
      "required": [
        "source_resolution_m",
        "event_area_ha",
        "valid_area_ha",
        "attributed_area_ha",
        "event_coverage_fraction",
        "attributed_event_fraction"
      ],
      "title": "AgriculturalSpatialSupport",
      "type": "object"
    }
  },
  "$id": "urn:deforestation-pipeline:agricultural-evidence:2.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato v2: una ocurrencia válida existe aunque el seguimiento sea corto.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_set_id": {
      "format": "uuid",
      "title": "Evidence Set Id",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/AgriculturalEvidenceObservationV2"
      },
      "title": "Observations",
      "type": "array"
    },
    "schema_version": {
      "default": "2.1.0",
      "enum": [
        "2.0.0",
        "2.1.0"
      ],
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "evidence_set_id",
    "created_at",
    "observations"
  ],
  "title": "AgriculturalEvidenceDocumentV2",
  "type": "object",
  "x-schema-version": "2.1.0"
}
