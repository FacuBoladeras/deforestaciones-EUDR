{
  "$defs": {
    "DisturbanceDetector": {
      "description": "Detectores planificados con roles diferentes y evidencia separada.",
      "enum": [
        "robust_seasonal_pre_post",
        "ccdc_benchmark"
      ],
      "title": "DisturbanceDetector",
      "type": "string"
    },
    "DisturbanceIndex": {
      "description": "Subconjunto inicial, deliberadamente pequeño, para detectar señales.",
      "enum": [
        "NDVI",
        "NBR",
        "NDMI",
        "NIRv"
      ],
      "title": "DisturbanceIndex",
      "type": "string"
    },
    "RobustSeasonalDetectorConfig": {
      "additionalProperties": false,
      "description": "Parámetros versionados del diagnóstico robusto estacional 14.2.",
      "properties": {
        "anomaly_threshold_applied": {
          "const": false,
          "title": "Anomaly Threshold Applied",
          "type": "boolean"
        },
        "mad_scale_constant": {
          "exclusiveMinimum": 0,
          "title": "Mad Scale Constant",
          "type": "number"
        },
        "minimum_reference_observations": {
          "minimum": 1,
          "title": "Minimum Reference Observations",
          "type": "integer"
        },
        "missing_data_policy": {
          "const": "preserve_nan_without_interpolation",
          "title": "Missing Data Policy",
          "type": "string"
        },
        "persistence_rule_applied": {
          "const": false,
          "title": "Persistence Rule Applied",
          "type": "boolean"
        },
        "reference_comparison_policy": {
          "const": "same_season_only",
          "title": "Reference Comparison Policy",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "vegetation_loss_direction": {
          "const": "decrease_is_positive",
          "title": "Vegetation Loss Direction",
          "type": "string"
        },
        "zero_scale_policy": {
          "const": "not_standardizable",
          "title": "Zero Scale Policy",
          "type": "string"
        }
      },
      "required": [
        "minimum_reference_observations",
        "mad_scale_constant",
        "vegetation_loss_direction",
        "reference_comparison_policy",
        "zero_scale_policy",
        "missing_data_policy",
        "anomaly_threshold_applied",
        "persistence_rule_applied"
      ],
      "title": "RobustSeasonalDetectorConfig",
      "type": "object"
    }
  },
  "$id": "urn:deforestation-pipeline:disturbance-detection:1.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Políticas científicas previas a implementar o parametrizar detectores.",
  "properties": {
    "analysis_start_date": {
      "format": "date",
      "title": "Analysis Start Date",
      "type": "string"
    },
    "attribution_allowed": {
      "const": false,
      "title": "Attribution Allowed",
      "type": "boolean"
    },
    "automatic_final_assessment_allowed": {
      "const": false,
      "title": "Automatic Final Assessment Allowed",
      "type": "boolean"
    },
    "baseline_disagreement_policy": {
      "const": "evaluate_and_flag",
      "title": "Baseline Disagreement Policy",
      "type": "string"
    },
    "cutoff_straddling_period_policy": {
      "const": "exclude",
      "title": "Cutoff Straddling Period Policy",
      "type": "string"
    },
    "detection_indices": {
      "items": {
        "$ref": "#/$defs/DisturbanceIndex"
      },
      "minItems": 2,
      "title": "Detection Indices",
      "type": "array"
    },
    "long_gap_interpolation_allowed": {
      "const": false,
      "title": "Long Gap Interpolation Allowed",
      "type": "boolean"
    },
    "minimum_baseline_source_count": {
      "minimum": 2,
      "title": "Minimum Baseline Source Count",
      "type": "integer"
    },
    "planned_detectors": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/DisturbanceDetector"
        },
        {
          "$ref": "#/$defs/DisturbanceDetector"
        }
      ],
      "title": "Planned Detectors",
      "type": "array"
    },
    "preserve_detector_disagreement": {
      "const": true,
      "title": "Preserve Detector Disagreement",
      "type": "boolean"
    },
    "preserve_detector_evidence": {
      "const": true,
      "title": "Preserve Detector Evidence",
      "type": "boolean"
    },
    "reference_history_start_date": {
      "format": "date",
      "title": "Reference History Start Date",
      "type": "string"
    },
    "robust_seasonal": {
      "$ref": "#/$defs/RobustSeasonalDetectorConfig"
    },
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score_semantics": {
      "const": "uncalibrated_disturbance_evidence_score",
      "title": "Score Semantics",
      "type": "string"
    },
    "spatial_area_threshold_applied": {
      "const": false,
      "title": "Spatial Area Threshold Applied",
      "type": "boolean"
    }
  },
  "required": [
    "reference_history_start_date",
    "analysis_start_date",
    "minimum_baseline_source_count",
    "detection_indices",
    "planned_detectors",
    "robust_seasonal",
    "score_semantics",
    "baseline_disagreement_policy",
    "cutoff_straddling_period_policy",
    "preserve_detector_evidence",
    "preserve_detector_disagreement",
    "long_gap_interpolation_allowed",
    "attribution_allowed",
    "spatial_area_threshold_applied",
    "automatic_final_assessment_allowed"
  ],
  "title": "DisturbanceDetectionConfig",
  "type": "object",
  "x-schema-version": "1.1.0"
}
