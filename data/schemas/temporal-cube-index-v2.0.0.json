{
  "$defs": {
    "HlsSeasonalPeriodProductRecord": {
      "additionalProperties": false,
      "properties": {
        "composite_input_inventory_path": {
          "title": "Composite Input Inventory Path",
          "type": "string"
        },
        "composite_metadata_path": {
          "title": "Composite Metadata Path",
          "type": "string"
        },
        "end_date_exclusive": {
          "format": "date",
          "title": "End Date Exclusive",
          "type": "string"
        },
        "indices_raster_path": {
          "title": "Indices Raster Path",
          "type": "string"
        },
        "indices_raster_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Indices Raster Sha256",
          "type": "string"
        },
        "l30_observation_count_raster_path": {
          "title": "L30 Observation Count Raster Path",
          "type": "string"
        },
        "l30_observation_count_raster_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "L30 Observation Count Raster Sha256",
          "type": "string"
        },
        "period_id": {
          "pattern": "^\\d{4}-(DJF|MAM|JJA|SON)$",
          "title": "Period Id",
          "type": "string"
        },
        "reflectance_raster_path": {
          "title": "Reflectance Raster Path",
          "type": "string"
        },
        "reflectance_raster_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Reflectance Raster Sha256",
          "type": "string"
        },
        "s30_observation_count_raster_path": {
          "title": "S30 Observation Count Raster Path",
          "type": "string"
        },
        "s30_observation_count_raster_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "S30 Observation Count Raster Sha256",
          "type": "string"
        },
        "season": {
          "$ref": "#/$defs/SeasonCode"
        },
        "season_year": {
          "title": "Season Year",
          "type": "integer"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "valid_observation_count_raster_path": {
          "title": "Valid Observation Count Raster Path",
          "type": "string"
        },
        "valid_observation_count_raster_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Valid Observation Count Raster Sha256",
          "type": "string"
        }
      },
      "required": [
        "period_id",
        "season_year",
        "season",
        "start_date",
        "end_date_exclusive",
        "composite_metadata_path",
        "composite_input_inventory_path",
        "reflectance_raster_path",
        "reflectance_raster_sha256",
        "indices_raster_path",
        "indices_raster_sha256",
        "valid_observation_count_raster_path",
        "valid_observation_count_raster_sha256",
        "l30_observation_count_raster_path",
        "l30_observation_count_raster_sha256",
        "s30_observation_count_raster_path",
        "s30_observation_count_raster_sha256"
      ],
      "title": "HlsSeasonalPeriodProductRecord",
      "type": "object"
    },
    "SeasonCode": {
      "enum": [
        "DJF",
        "MAM",
        "JJA",
        "SON"
      ],
      "title": "SeasonCode",
      "type": "string"
    },
    "SpectralIndex": {
      "description": "Índices ópticos candidatos para el benchmark inicial.",
      "enum": [
        "NDVI",
        "EVI2",
        "NBR",
        "NDMI",
        "NMDI",
        "LSWI",
        "NIRv",
        "kNDVI"
      ],
      "title": "SpectralIndex",
      "type": "string"
    }
  },
  "$id": "urn:deforestation-pipeline:temporal-cube-index:2.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Índice físico virtual: dimensiones lógicas sobre GeoTIFF planos.",
  "properties": {
    "cube_index_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Cube Index Sha256",
      "type": "string"
    },
    "cube_spec_path": {
      "const": "json/temporal/seasonal/cube_spec.json",
      "default": "json/temporal/seasonal/cube_spec.json",
      "title": "Cube Spec Path",
      "type": "string"
    },
    "cube_spec_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Cube Spec Sha256",
      "type": "string"
    },
    "grid_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Grid Sha256",
      "type": "string"
    },
    "interpolation_allowed": {
      "const": false,
      "title": "Interpolation Allowed",
      "type": "boolean"
    },
    "missing_data_policy": {
      "const": "preserve_missing_no_interpolation",
      "title": "Missing Data Policy",
      "type": "string"
    },
    "observation_count_dimensions": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "const": "time",
          "type": "string"
        },
        {
          "const": "sensor",
          "type": "string"
        },
        {
          "const": "y",
          "type": "string"
        },
        {
          "const": "x",
          "type": "string"
        }
      ],
      "title": "Observation Count Dimensions",
      "type": "array"
    },
    "period_axis": {
      "items": {
        "type": "string"
      },
      "title": "Period Axis",
      "type": "array"
    },
    "period_products": {
      "items": {
        "$ref": "#/$defs/HlsSeasonalPeriodProductRecord"
      },
      "title": "Period Products",
      "type": "array"
    },
    "reflectance_band_axis": {
      "items": {
        "type": "string"
      },
      "title": "Reflectance Band Axis",
      "type": "array"
    },
    "reflectance_dimensions": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "const": "time",
          "type": "string"
        },
        {
          "const": "reflectance_band",
          "type": "string"
        },
        {
          "const": "y",
          "type": "string"
        },
        {
          "const": "x",
          "type": "string"
        }
      ],
      "title": "Reflectance Dimensions",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sensor_axis": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "const": "total",
          "type": "string"
        },
        {
          "const": "HLSL30",
          "type": "string"
        },
        {
          "const": "HLSS30",
          "type": "string"
        }
      ],
      "title": "Sensor Axis",
      "type": "array"
    },
    "spectral_index_axis": {
      "items": {
        "$ref": "#/$defs/SpectralIndex"
      },
      "title": "Spectral Index Axis",
      "type": "array"
    },
    "spectral_index_dimensions": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "const": "time",
          "type": "string"
        },
        {
          "const": "index",
          "type": "string"
        },
        {
          "const": "y",
          "type": "string"
        },
        {
          "const": "x",
          "type": "string"
        }
      ],
      "title": "Spectral Index Dimensions",
      "type": "array"
    },
    "storage_model": {
      "const": "virtual_geotiff_collection",
      "default": "virtual_geotiff_collection",
      "title": "Storage Model",
      "type": "string"
    }
  },
  "required": [
    "cube_spec_sha256",
    "grid_sha256",
    "period_axis",
    "reflectance_band_axis",
    "spectral_index_axis",
    "sensor_axis",
    "reflectance_dimensions",
    "spectral_index_dimensions",
    "observation_count_dimensions",
    "period_products",
    "missing_data_policy",
    "interpolation_allowed",
    "cube_index_sha256"
  ],
  "title": "TemporalCubeIndex",
  "type": "object",
  "x-schema-version": "2.0.0"
}
