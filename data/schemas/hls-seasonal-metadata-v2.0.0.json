{
  "$defs": {
    "HlsSeasonalPeriodProductRecord": {
      "additionalProperties": false,
      "properties": {
        "composite_input_inventory_path": {
          "title": "Composite Input Inventory Path",
          "type": "string"
        },
        "composite_metadata_path": {
          "title": "Composite Metadata Path",
          "type": "string"
        },
        "end_date_exclusive": {
          "format": "date",
          "title": "End Date Exclusive",
          "type": "string"
        },
        "indices_raster_path": {
          "title": "Indices Raster Path",
          "type": "string"
        },
        "indices_raster_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Indices Raster Sha256",
          "type": "string"
        },
        "l30_observation_count_raster_path": {
          "title": "L30 Observation Count Raster Path",
          "type": "string"
        },
        "l30_observation_count_raster_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "L30 Observation Count Raster Sha256",
          "type": "string"
        },
        "period_id": {
          "pattern": "^\\d{4}-(DJF|MAM|JJA|SON)$",
          "title": "Period Id",
          "type": "string"
        },
        "reflectance_raster_path": {
          "title": "Reflectance Raster Path",
          "type": "string"
        },
        "reflectance_raster_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Reflectance Raster Sha256",
          "type": "string"
        },
        "s30_observation_count_raster_path": {
          "title": "S30 Observation Count Raster Path",
          "type": "string"
        },
        "s30_observation_count_raster_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "S30 Observation Count Raster Sha256",
          "type": "string"
        },
        "season": {
          "$ref": "#/$defs/SeasonCode"
        },
        "season_year": {
          "title": "Season Year",
          "type": "integer"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "valid_observation_count_raster_path": {
          "title": "Valid Observation Count Raster Path",
          "type": "string"
        },
        "valid_observation_count_raster_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Valid Observation Count Raster Sha256",
          "type": "string"
        }
      },
      "required": [
        "period_id",
        "season_year",
        "season",
        "start_date",
        "end_date_exclusive",
        "composite_metadata_path",
        "composite_input_inventory_path",
        "reflectance_raster_path",
        "reflectance_raster_sha256",
        "indices_raster_path",
        "indices_raster_sha256",
        "valid_observation_count_raster_path",
        "valid_observation_count_raster_sha256",
        "l30_observation_count_raster_path",
        "l30_observation_count_raster_sha256",
        "s30_observation_count_raster_path",
        "s30_observation_count_raster_sha256"
      ],
      "title": "HlsSeasonalPeriodProductRecord",
      "type": "object"
    },
    "SeasonCode": {
      "enum": [
        "DJF",
        "MAM",
        "JJA",
        "SON"
      ],
      "title": "SeasonCode",
      "type": "string"
    }
  },
  "$id": "urn:deforestation-pipeline:hls-seasonal-metadata:2.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "composite_method": {
      "const": "median_reflectance_then_indices",
      "title": "Composite Method",
      "type": "string"
    },
    "cube_index_path": {
      "const": "json/temporal/seasonal/cube_index.json",
      "default": "json/temporal/seasonal/cube_index.json",
      "title": "Cube Index Path",
      "type": "string"
    },
    "cube_spec_path": {
      "const": "json/temporal/seasonal/cube_spec.json",
      "default": "json/temporal/seasonal/cube_spec.json",
      "title": "Cube Spec Path",
      "type": "string"
    },
    "end_year": {
      "title": "End Year",
      "type": "integer"
    },
    "final_assessment_generated": {
      "const": false,
      "default": false,
      "title": "Final Assessment Generated",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "grid_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Grid Sha256",
      "type": "string"
    },
    "period_ids": {
      "items": {
        "type": "string"
      },
      "title": "Period Ids",
      "type": "array"
    },
    "period_products": {
      "items": {
        "$ref": "#/$defs/HlsSeasonalPeriodProductRecord"
      },
      "title": "Period Products",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_products": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "const": "HLSL30",
          "type": "string"
        },
        {
          "const": "HLSS30",
          "type": "string"
        }
      ],
      "title": "Source Products",
      "type": "array"
    },
    "stage": {
      "const": "seasonal_rasters_materialized",
      "default": "seasonal_rasters_materialized",
      "title": "Stage",
      "type": "string"
    },
    "start_year": {
      "title": "Start Year",
      "type": "integer"
    },
    "total_estimated_uncompressed_bytes": {
      "exclusiveMinimum": 0,
      "title": "Total Estimated Uncompressed Bytes",
      "type": "integer"
    },
    "window_plan_path": {
      "const": "json/temporal/seasonal/window_plan.json",
      "default": "json/temporal/seasonal/window_plan.json",
      "title": "Window Plan Path",
      "type": "string"
    },
    "window_plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Window Plan Sha256",
      "type": "string"
    }
  },
  "required": [
    "generated_at",
    "start_year",
    "end_year",
    "period_ids",
    "window_plan_sha256",
    "grid_sha256",
    "source_products",
    "composite_method",
    "total_estimated_uncompressed_bytes",
    "period_products"
  ],
  "title": "HlsSeasonalMetadata",
  "type": "object",
  "x-schema-version": "2.0.0"
}
